# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=adad_user
DB_PASSWORD=adad_secure_password
DB_NAME=adad_db

# LLM API Configuration (OpenAI or Gemini API compatible)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Cron Timing Configuration
EVENING_CRON_HOUR=19
EVENING_CRON_MINUTE=0
MORNING_CRON_HOUR=9
MORNING_CRON_MINUTE=0
TIMEZONE=Asia/Tashkent

